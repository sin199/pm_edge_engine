{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sin199/pm_edge_engine/blob/main/schemas/fair_probs_output.schema.json",
  "title": "FairProbsOutput",
  "description": "Output shape for pm_edge_engine predict.",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["market_slug", "fair_probs"],
        "properties": {
          "market_slug": {
            "type": "string"
          },
          "fair_probs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
